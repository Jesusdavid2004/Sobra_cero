DATABASE_URL=postgresql+psycopg2://sobracero:sobracero@localhost:5432/sobracero
REDIS_URL=redis://localhost:6379/0
APP_ENVIRONMENT=development
JWT_SECRET=development-only-secret-change-me-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=sc_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# S3-compatible storage (MinIO is archived; LocalStack is the local default)
MINIO_ENDPOINT=localhost:4566
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lots
MINIO_PUBLIC_URL=http://localhost:4566
MINIO_SECURE=false

# LLM provider: mock | openai | ollama | groq | openrouter
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.20",
